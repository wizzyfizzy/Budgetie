        "profile_faq_getting_started_title": {
            "extractionState": "manual",
            "localizations": {
                "en": { "stringUnit": { "state": "translated", "value": "Getting Started" } },
                "el": { "stringUnit": { "state": "translated", "value": "Εισαγωγή" } }
            }
        },
        "profile_faq_getting_started_question1": {
            "extractionState": "manual",
            "localizations": {
                "en": { "stringUnit": { "state": "translated", "value": "How do I create an account?" } },
                "el": { "stringUnit": { "state": "translated", "value": "Πώς δημιουργώ λογαριασμό;" } }
            }
        },
        "profile_faq_getting_started_answer1": {
            "extractionState": "manual",
            "localizations": {
                "en": { "stringUnit": { "state": "translated", "value": "Tap on 'Sign Up' in the login screen and enter your name, email, and password. You can also use Sign in with Apple." } },
                "el": { "stringUnit": { "state": "translated", "value": "Πάτησε το 'Εγγραφή' στην οθόνη σύνδεσης και εισάγετε το όνομά σου, email και κωδικό. Μπορείς επίσης να χρησιμοποιήσεις Σύνδεση με Apple." } }
            }
        },
        "profile_faq_getting_started_question2": {
            "extractionState": "manual",
            "localizations": {
                "en": { "stringUnit": { "state": "translated", "value": "How do I reset my password?" } },
                "el": { "stringUnit": { "state": "translated", "value": "Πώς επαναφέρω τον κωδικό μου;" } }
            }
        },
        "profile_faq_getting_started_answer2": {
            "extractionState": "manual",
            "localizations": {
                "en": { "stringUnit": { "state": "translated", "value": "On the login screen, tap 'Forgot Password' and enter your email. We’ll send you a reset link." } },
                "el": { "stringUnit": { "state": "translated", "value": "Στην οθόνη σύνδεσης, πάτησε 'Ξέχασα τον κωδικό' και εισάγετε το email σου. Θα σου στείλουμε σύνδεσμο επαναφοράς." } }
            }
        },
        "profile_faq_subscriptions_title": {
            "extractionState": "manual",
            "localizations": {
                "en": { "stringUnit": { "state": "translated", "value": "Subscriptions & Expenses" } },
                "el": { "stringUnit": { "state": "translated", "value": "Συνδρομές & Έξοδα" } }
            }
        },
        "profile_faq_subscriptions_question1": {
            "extractionState": "manual",
            "localizations": {
                "en": { "stringUnit": { "state": "translated", "value": "How do I add a subscription?" } },
                "el": { "stringUnit": { "state": "translated", "value": "Πώς προσθέτω μια συνδρομή;" } }
            }
        },
        "profile_faq_subscriptions_answer1": {
            "extractionState": "manual",
            "localizations": {
                "en": { "stringUnit": { "state": "translated", "value": "Go to the Subscriptions tab, tap the + button, and fill in the details such as name, cost, and renewal date." } },
                "el": { "stringUnit": { "state": "translated", "value": "Πήγαινε στην καρτέλα Συνδρομές, πάτησε το κουμπί + και συμπλήρωσε τα στοιχεία όπως όνομα, κόστος και ημερομηνία ανανέωσης." } }
            }
        },
        "profile_faq_subscriptions_question2": {
            "extractionState": "manual",
            "localizations": {
                "en": { "stringUnit": { "state": "translated", "value": "How do I edit or cancel a subscription?" } },
                "el": { "stringUnit": { "state": "translated", "value": "Πώς μπορώ να επεξεργαστώ ή να ακυρώσω μια συνδρομή;" } }
            }
        },
        "profile_faq_subscriptions_answer2": {
            "extractionState": "manual",
            "localizations": {
                "en": { "stringUnit": { "state": "translated", "value": "Tap on the subscription you want to change, then select 'Edit' or 'Delete' from the options." } },
                "el": { "stringUnit": { "state": "translated", "value": "Πάτησε στη συνδρομή που θέλεις να αλλάξεις και μετά επέλεξε 'Επεξεργασία' ή 'Διαγραφή' από τις επιλογές." } }
            }
        },
        "profile_faq_subscriptions_question3": {
            "extractionState": "manual",
            "localizations": {
                "en": { "stringUnit": { "state": "translated", "value": "Can I set reminders for bills?" } },
                "el": { "stringUnit": { "state": "translated", "value": "Μπορώ να ορίσω υπενθυμίσεις για τους λογαριασμούς;" } }
            }
        },
        "profile_faq_subscriptions_answer3": {
            "extractionState": "manual",
            "localizations": {
                "en": { "stringUnit": { "state": "translated", "value": "Yes. In Settings > Notifications you can enable reminders and choose a time that works best for you." } },
                "el": { "stringUnit": { "state": "translated", "value": "Ναι. Στις Ρυθμίσεις > Ειδοποιήσεις μπορείς να ενεργοποιήσεις υπενθυμίσεις και να επιλέξεις την ώρα που σου ταιριάζει." } }
            }
        },
        "profile_faq_features_title": {
            "extractionState": "manual",
            "localizations": {
                "en": { "stringUnit": { "state": "translated", "value": "Features" } },
                "el": { "stringUnit": { "state": "translated", "value": "Δυνατότητες" } }
            }
        },
        "profile_faq_features_question1": {
            "extractionState": "manual",
            "localizations": {
                "en": { "stringUnit": { "state": "translated", "value": "How do I scan a receipt?" } },
                "el": { "stringUnit": { "state": "translated", "value": "Πώς μπορώ να σαρώσω μια απόδειξη;" } }
            }
        },
        "profile_faq_features_answer1": {
            "extractionState": "manual",
            "localizations": {
                "en": { "stringUnit": { "state": "translated", "value": "Go to Transactions, tap the camera icon, and scan your receipt. Budgetie will automatically recognize and add the details." } },
                "el": { "stringUnit": { "state": "translated", "value": "Πήγαινε στα Έξοδα, πάτησε το εικονίδιο της κάμερας και σάρωσε την απόδειξή σου. Το Budgetie θα αναγνωρίσει και θα προσθέσει αυτόματα τις λεπτομέρειες." } }
            }
        },
        "profile_faq_features_question2": {
            "extractionState": "manual",
            "localizations": {
                "en": { "stringUnit": { "state": "translated", "value": "Can I analyze my spending?" } },
                "el": { "stringUnit": { "state": "translated", "value": "Μπορώ να αναλύσω τις δαπάνες μου;" } }
            }
        },
        "profile_faq_features_answer2": {
            "extractionState": "manual",
            "localizations": {
                "en": { "stringUnit": { "state": "translated", "value": "Yes. The Analytics tab uses charts and AI suggestions to help you understand and optimize your spending." } },
                "el": { "stringUnit": { "state": "translated", "value": "Ναι. Η καρτέλα Αναλύσεις χρησιμοποιεί γραφήματα και προτάσεις AI για να σε βοηθήσει να κατανοήσεις και να βελτιστοποιήσεις τις δαπάνες σου." } }
            }
        },
        "profile_faq_features_question3": {
            "extractionState": "manual",
            "localizations": {
                "en": { "stringUnit": { "state": "translated", "value": "Does Budgetie work on Apple Watch?" } },
                "el": { "stringUnit": { "state": "translated", "value": "Το Budgetie λειτουργεί στο Apple Watch;" } }
            }
        },
        "profile_faq_features_answer3": {
            "extractionState": "manual",
            "localizations": {
                "en": { "stringUnit": { "state": "translated", "value": "Yes. You can quickly log expenses and view your balance from the companion Watch app." } },
                "el": { "stringUnit": { "state": "translated", "value": "Ναι. Μπορείς να καταγράψεις γρήγορα έξοδα και να δεις το υπόλοιπό σου από την εφαρμογή Watch." } }
            }
        },
        "profile_faq_security_title": {
          "extractionState": "manual",
          "localizations": {
            "en": { "stringUnit": { "state": "translated", "value": "Security & Data" } },
            "el": { "stringUnit": { "state": "translated", "value": "Ασφάλεια & Δεδομένα" } }
          }
        },
        "profile_faq_security_question1": {
            "extractionState": "manual",
            "localizations": {
                "en": { "stringUnit": { "state": "translated", "value": "Where is my data stored?" } },
                "el": { "stringUnit": { "state": "translated", "value": "Πού αποθηκεύονται τα δεδομένα μου;" } }
            }
        },
        "profile_faq_security_answer1": {
            "extractionState": "manual",
            "localizations": {
                "en": { "stringUnit": { "state": "translated", "value": "Your data is securely stored on your device using iCloud Keychain and can be synced safely across your devices." } },
                "el": { "stringUnit": { "state": "translated", "value": "Τα δεδομένα σου αποθηκεύονται με ασφάλεια στη συσκευή σου χρησιμοποιώντας το iCloud Keychain και μπορούν να συγχρονιστούν με ασφάλεια σε όλες τις συσκευές σου." } }
            }
        },
        "profile_faq_security_question2": {
            "extractionState": "manual",
            "localizations": {
                "en": { "stringUnit": { "state": "translated", "value": "Is my payment information safe?" } },
                "el": { "stringUnit": { "state": "translated", "value": "Είναι ασφαλείς οι πληροφορίες πληρωμής μου;" } }
            }
        },
        "profile_faq_security_answer2": {
            "extractionState": "manual",
            "localizations": {
                "en": { "stringUnit": { "state": "translated", "value": "Yes. Payments are processed through Braintree with full PCI compliance. We never store your card details." } },
                "el": { "stringUnit": { "state": "translated", "value": "Ναι. Οι πληρωμές γίνονται μέσω Braintree με πλήρη συμμόρφωση PCI. Δεν αποθηκεύουμε ποτέ τα στοιχεία της κάρτας σου." } }
            }
        },
        "profile_faq_security_question3": {
            "extractionState": "manual",
            "localizations": {
                "en": { "stringUnit": { "state": "translated", "value": "Can I export my data?" } },
                "el": { "stringUnit": { "state": "translated", "value": "Μπορώ να εξάγω τα δεδομένα μου;" } }
            }
        },
        "profile_faq_security_answer3": {
            "extractionState": "manual",
            "localizations": {
                "en": { "stringUnit": { "state": "translated", "value": "Yes. Go to Settings > Export Data to download your transactions in CSV format." } },
                "el": { "stringUnit": { "state": "translated", "value": "Ναι. Πήγαινε στις Ρυθμίσεις > Εξαγωγή Δεδομένων για να κατεβάσεις τις συναλλαγές σου σε μορφή CSV." } }
            }
        },
