        "onboarding_step1_description" : {
            "comment" : "Welcome",
            "extractionState" : "manual",
            "localizations" : {
                "el" : {
                    "stringUnit" : {
                        "state" : "translated",
                        "value" : "Παρακολούθησε τα μηνιαία έξοδά σου. Έλεγξε τα χρήματά σου με στυλ!"
                    }
                },
                "en" : {
                    "stringUnit" : {
                        "state" : "translated",
                        "value" : "Monitor your monthly expenses. Master your money! Budget it with style!"
                    }
                }
            }
        },
        "onboarding_step1_title" : {
            "extractionState" : "manual",
