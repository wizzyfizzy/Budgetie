        "profile_privacy_policy_accessibility" : {
            "extractionState" : "manual",
            "localizations" : {
                "el" : {
                    "stringUnit" : {
                        "state" : "translated",
                        "value" : "Περιεχόμενο Πολιτικής Απορρήτου"
                    }
                },
                "en" : {
                    "stringUnit" : {
                        "state" : "translated",
                        "value" : "Privacy Policy content"
                    }
                }
            }
        },
        "profile_privacy_policy_content" : {
            "extractionState" : "manual",
            "localizations" : {
                "el" : {
                    "stringUnit" : {
                        "state" : "translated",
                        "value": "Η ιδιωτικότητά σας είναι σημαντική για εμάς. Δείτε πώς το Budgetie διαχειρίζεται τα δεδομένα σας:\n\n1. Τα προσωπικά σας δεδομένα αποθηκεύονται με ασφάλεια στη συσκευή σας και συγχρονίζονται μέσω iCloud, αν είναι ενεργοποιημένο.\n2. Δεν πωλούμε ή μοιραζόμαστε τα δεδομένα σας με τρίτους.\n3. Τα δεδομένα πληρωμών επεξεργάζονται με ασφάλεια μέσω Braintree. Το Budgetie δεν αποθηκεύει ποτέ τα στοιχεία της κάρτας σας.\n4. Μπορείτε να εξάγετε ή να διαγράψετε τα δεδομένα σας οποιαδήποτε στιγμή από το μενού Ρυθμίσεις."
                    }
                },
                "en" : {
                    "stringUnit" : {
                        "state" : "translated",
                        "value": "Your privacy is important to us. Here’s how Budgetie handles your data:\n\n1. Your personal data is stored securely on your device and synced through iCloud if enabled.\n2. We do not sell or share your data with third parties.\n3. Payment data is processed securely via Braintree. Budgetie never stores your card details.\n4. You can export or delete your data anytime from the Settings menu."
                    }
                }
            }
        },
        "profile_settings" : {
            "extractionState" : "manual",
            "localizations" : {
                "el" : {
                    "stringUnit" : {
                        "state" : "translated",
                        "value" : "Ρυθμίσεις"
                    }
                },
                "en" : {
                    "stringUnit" : {
