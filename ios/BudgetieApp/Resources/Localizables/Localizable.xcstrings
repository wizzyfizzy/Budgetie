                        "value" : "Terms of Service"
                    }
                }
            }
        },
        "profile_terms_of_service_accessibility" : {
            "extractionState" : "manual",
            "localizations" : {
                "el" : {
                    "stringUnit" : {
                        "state" : "translated",
                        "value" : "Περιεχόμενο Όρων Χρήσης"
                    }
                },
                "en" : {
                    "stringUnit" : {
                        "state" : "translated",
                        "value" : "Terms of Service content"
                    }
                }
            }
        },
        "profile_terms_of_service_content" : {
            "extractionState" : "manual",
            "localizations" : {
                "el" : {
                    "stringUnit" : {
                        "state" : "translated",
                        "value": "Καλώς ήρθατε στο Budgetie! Χρησιμοποιώντας την εφαρμογή μας, συμφωνείτε με τους παρακάτω όρους:\n\n1. Το Budgetie σας βοηθά να διαχειρίζεστε τις συνδρομές και τα έξοδά σας, αλλά δεν παρέχει οικονομικές συμβουλές.\n2. Είστε υπεύθυνοι για την ακρίβεια των πληροφοριών που εισάγετε.\n3. Μπορεί να ενημερώνουμε αυτούς τους όρους περιοδικά. Η συνεχής χρήση του Budgetie σημαίνει ότι αποδέχεστε τις ενημερώσεις.\n4. Μην καταχράστε την εφαρμογή ή προσπαθήσετε να διακόψετε τις υπηρεσίες της."
                    }
                },
                "en" : {
                    "stringUnit" : {
                        "state" : "translated",
                        "value": "Welcome to Budgetie! By using our app, you agree to the following terms:\n\n1. Budgetie helps you manage your subscriptions and expenses, but does not provide financial advice.\n2. You are responsible for the accuracy of the information you enter.\n3. We may update these terms occasionally. Continued use of Budgetie means you accept the updates.\n4. Do not misuse the app or attempt to disrupt its services."
                    }
                }
            }
        },
