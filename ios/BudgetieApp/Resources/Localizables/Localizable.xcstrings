        "onboarding_step3_description" : {
            "extractionState" : "manual",
            "localizations" : {
                "el" : {
                    "stringUnit" : {
                        "state" : "translated",
                        "value" : "Ανακάλυψε έξυπνους τρόπους διαχείρισης με βοήθεια από AI."
                    }
                },
                "en" : {
                    "stringUnit" : {
                        "state" : "translated",
                        "value" : "Discover smarter ways to manage your budget with AI-powered tips."
